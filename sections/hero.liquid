<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>

{% assign produtos = section.settings.colecoes-do-verao %}


<style>
.swiper {
  width: 600px;
  height: 500px;
  margin-bottom: 50px;
}

.swiper-slide {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.lista-de-produtos {
  display: flex;
  justify-content: center;
  
}
.lista-produto {
  text-align: center;
  margin-left: 50px;
}
.lista-produto > a {
  background-color: bisque;
  padding: 4px;
}
.cta {
  margin-top: 150px;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 40px;
}
.cta > button {
  height: 70px;
  width: 550px;
  border-radius: 30px;
  font-size: 40px;
}

.cta > p {
  margin-bottom: 4px;
}

</style>

<!-- Slider main container -->
<div class="swiper">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->
    {% comment %} <div class="swiper-slide">Slide 1</div> {% endcomment %}
    {% for product in produtos.products %}
      <div class="swiper-slide">
       <h2>{{ product.title }} </h2> 
        <img src="{{ product.featured_image | image_url: width:'300px' }}" width="300px" height="auto">
        {{ product.description }}
        <button>Adicione ao carrinho</button>
      </div>
    {% endfor %}
  </div>
  <!-- If we need pagination -->
  <div class="swiper-pagination"></div>

  <!-- If we need navigation buttons -->
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>

  <!-- If we need scrollbar -->
  <div class="swiper-scrollbar"></div>
</div>

<div class="lista-de-produtos">
  {% for produto in produtos.products %}
    <div class="lista-produto">
      <p> <strong>{{ produto.title }} </strong></p>
       <img src="{{ produto.featured_image | image_url: width:'150px' }}" width="150px" height="auto">
        <p>Preço: <strong>{{ produto.price |  money}}</strong> </p>
        <a href="{{ produto.url }}">Clique aqui</a> 
    </div>
  {% endfor %}
</div>

<div class="cta">
  <p>Inscreva-se e ganhe 10% de desconto na loja</p>
  <button id="cta-button">Inscreva-se</button>
</div>


<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<script id="schema" async>
  {{ section.settings.locao-principal.url }}
</script>

<script defer>
const swiper = new Swiper('.swiper', {
  // Optional parameters
  direction: 'horizontal',
  loop: true,

  // If we need pagination
  pagination: {
    el: '.swiper-pagination',
  },

  // Navigation arrows
  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },

  // And if we need scrollbar
  scrollbar: {
    el: '.swiper-scrollbar',
  },
});

const ctaButton = document.getElementById('cta-button')
ctaButton.addEventListener('click', ()=>{
  const schema = document.getElementById('schema').textContent
  console.log (schema)

  window.location.href = schema
})
</script>

{% schema %}
{
  "name": "Coleção Slider",
  "settings": [
    {
      "type": "collection",
      "id": "colecoes-do-verao",
      "label": "Coleção Slider"
    },

    {
      "type": "product",
      "id": "locao-principal",
      "label": "Produto CTA"
    }
    
    ]
}
{% endschema %}